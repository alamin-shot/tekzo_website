# -----------------------------------------------------------------------------
# Environment template. Copy to `.env.local` and fill in real values.
#   cp .env.example .env.local
# NEVER commit real values. `.env*` is git-ignored; only this template is tracked.
#
# NEXT_PUBLIC_* values are PUBLIC: they are inlined into the browser bundle at
# BUILD time, so changing them requires a rebuild. Never put secrets in them.
# -----------------------------------------------------------------------------

# Backend API base URL, including the version prefix, no trailing slash.
# Used server-side (lib/api, proxy, route handlers) and in the browser.
# Example format: https://web-api.example.com/api/v1
NEXT_PUBLIC_API_URL=

# Public site origin, no trailing slash. Used for canonical URLs, sitemaps,
# robots.txt, OpenGraph and JSON-LD.
# Example format: https://www.example.com
NEXT_PUBLIC_URL=

# Google Tag Manager container ID (public; appears in every page's HTML).
# Example format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Storefront variant flag. Set to `salamat` to show the Partners menu and
# footer links; leave empty for the Tekzo storefront.
NEXT_PUBLIC_ECOMMERCE_TYPE=

# SERVER-ONLY SECRET. Shared secret the backend sends to POST /api/revalidate
# to purge cached pages and data. Generate with: openssl rand -hex 32
# Must match the value configured in the backend's revalidation webhook.
REVALIDATION_SECRET=

# SERVER-ONLY SECRET. Must equal INTERNAL_API_TOKEN on the API server.
# Sent as X-Internal-Token on server-side API calls.
INTERNAL_API_TOKEN=

# NOTE: do NOT set NODE_ENV here. `next dev` sets development, and
# `next build`/`next start` set production automatically (it controls the
# Secure flag on auth cookies in src/Components/Login/actions.js).
